[Unit]
Description=ZYArm real control and camera stack
After=network-online.target foxglove-bridge.service
Wants=network-online.target
Requires=foxglove-bridge.service

[Service]
Type=simple
User=frank
WorkingDirectory=/home/frank/ZYArm-X1/software/ros2_ws
Environment=ROS_LOCALHOST_ONLY=0
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -e /dev/ttyUSB0
ExecStartPre=/usr/bin/test -e /dev/v4l/by-id/usb-XHH-260128-A_2M-video-index0
ExecStart=/bin/bash -lc "source /opt/ros/jazzy/setup.bash && source /home/frank/ZYArm-X1/software/ros2_ws/install/setup.bash && exec /home/frank/ZYArm-X1/software/ros2_ws/install/zyarm_bringup/lib/zyarm_bringup/zyarm_stack --systemd-daemon"
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=20
Restart=no

[Install]
WantedBy=multi-user.target
